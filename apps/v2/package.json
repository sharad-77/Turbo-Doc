{
  "name": "@turbo-doc/api-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --env-file=.env.staging --import=tsx/esm --watch src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env.production dist/index.js",
    "prod": "node --env-file=.env.production dist/index.js",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-types": "tsc --noEmit",
    "check": "pnpm format:check && pnpm lint && pnpm check-types"
  },
  "dependencies": {
    "@repo/auth-v2": "workspace:*",
    "@repo/database-v2": "workspace:*",
    "@repo/redis": "workspace:*",
    "body-parser": "^2.3.0",
    "bullmq": "^6.3.6",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "finalhandler": "^2.1.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "router": "^2.2.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/finalhandler": "^1.2.4",
    "@types/node": "^22.15.3",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.5.4",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
