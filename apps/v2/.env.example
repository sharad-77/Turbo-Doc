# Database
DATABASE_URL="postgresql://user:password@localhost:5432/turbodoc_v2?schema=public"

# API Configuration
HOST="0.0.0.0"
PORT=3001
NODE_ENV="staging"
API_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Redis
REDIS_URL="redis://localhost:6379"

# Better Auth
BETTER_AUTH_SECRET="your-32-char-random-secret-key-goes-here"
BETTER_AUTH_URL="http://localhost:3001"
COOKIE_DOMAIN="" # e.g. "sharad.fun" in production for cross-subdomain cookies on Safari ITP

# Resend Email
RESEND_API_KEY="re_..."
EMAIL_FROM="Turbo-Doc <onboarding@resend.dev>"

# OAuth (Optional for local testing)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# AWS S3 
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="your-aws-region"
AWS_BUCKET_NAME="your-bucket-name"

# WhatsApp Agent
WHATSAPP_WEBHOOK_SECRET="your-webhook-secret"
GEMINI_API_KEY="your-gemini-key"
